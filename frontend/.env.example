# Entra ID — SPA app registration (public client)
# Register SPA redirect URIs:
#   http://localhost:3000
#   http://localhost:3000/auth-redirect.html   ← required for login popup completion
APP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
APP_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# API app (resource) — must match backend APP_AZURE_API_CLIENT_ID
APP_AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Delegated scope exposed by the API app
APP_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# API base URL (empty = same origin / Vite proxy in dev)
APP_API_BASE_URL=

# Optional: proxy target when using Vite dev server
# APP_API_PROXY_TARGET=http://localhost:8080
