# Local Vite (npm run dev) loads this file into the process environment
# and serves it as /config.js. Production reads the same names from
# system environment variables (Azure App Service application settings).
#
# Entra ID — SPA app registration (public client)
# Register SPA redirect URIs:
#   http://localhost:3000
#   http://localhost:3000/auth-redirect.html   ← required for login popup completion
APP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Delegated scope exposed by the API app
APP_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Backend origin. Vite proxies /api there in dev (see APP_API_PROXY_TARGET).
# Production server.mjs also proxies /api there; the UI itself listens on PORT (3000).
APP_API_BASE_URL=

# Optional: proxy target when using Vite dev server
# APP_API_PROXY_TARGET=http://localhost:8080
