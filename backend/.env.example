# =============================================================================
# Platform Management Service — backend environment template
# =============================================================================
# Copy to .env and fill in real values (never commit .env):
#   cp .env.example .env
#
# Load before local run (Spring Boot does not load .env by itself):
#   set -a && source .env && set +a
#   mvn spring-boot:run
#
# Docker example:
#   docker run --env-file .env -p 8080:8080 <image>
#
# Bound from application.yml (see app.security.* and spring.security.oauth2.*).
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Microsoft Entra ID (Azure AD) resource server
# -----------------------------------------------------------------------------
# Directory (tenant) ID of the Entra tenant that issues API access tokens.
APP_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the API app registration.
# Used as JWT audience (bare client id and api://{client-id}).
APP_AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Optional — security / CORS
# -----------------------------------------------------------------------------
# Extra filter-layer gate on all /api/** calls (SCOPE_<name> or ROLE_<name>).
# Leave empty to authorize only via Entra app roles:
#   System.Maintainer | System.Reader | Entitlement.Reader | Consumption.Registrator
# Example: access_as_user
APP_AZURE_REQUIRED_SCOPE=

# Comma-separated browser origins allowed for CORS (SPA frontends).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional — Spring / server runtime
# -----------------------------------------------------------------------------
# Active profiles: leave empty for default (local H2 + Entra JWT).
# Use "k8s" for container/AKS (disables H2 console, enables probes).
# Use "local" for more verbose security logging (still requires Entra JWT).
# SPRING_PROFILES_ACTIVE=local

# HTTP port (default 8080).
# SERVER_PORT=8080

# OpenAPI / Swagger UI (default true). Set false to hide /swagger-ui and /v3/api-docs.
# APP_SWAGGER_ENABLED=true

# Logging overrides (optional; defaults live in application.yml / logback-spring.xml).
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_EXAMPLE_PLATFORMMANAGEMENT=DEBUG

# -----------------------------------------------------------------------------
# Optional — token helper scripts only (scripts/get-token-*.sh)
# Not required to start the API; used when acquiring JWTs for manual testing.
# -----------------------------------------------------------------------------
# SPA / public client app registration (device-code / delegated human tokens).
# AZURE_HUMAN_CLIENT_ID=

# Technical client credentials (app tokens with roles claim).
# AZURE_TECH_CLIENT_ID=
# AZURE_TECH_CLIENT_SECRET=

# User-assigned managed identity client id (IMDS / az login --identity).
# AZURE_MI_CLIENT_ID=

# Override token scope/resource (defaults derived from APP_AZURE_API_CLIENT_ID).
# API_SCOPE=api://${APP_AZURE_API_CLIENT_ID}/access_as_user
# MI_SCOPE=api://${APP_AZURE_API_CLIENT_ID}/.default
# MI_RESOURCE=api://${APP_AZURE_API_CLIENT_ID}
